//*******************************************************************************************************
//* model for Nwell resistor under STI 
subckt nwell(1 2 3)
parameters m=1
parameters r_length=1u
parameters r_width=1u
parameters dtemp=0
parameters par=1
parameters s=1
parameters r_rsh0=rsh_nwell
parameters r_dw=2.22e-7
parameters r_dl=1.02e-8
parameters r_vc1=0
parameters r_vc2=0
parameters r_tc1=2.285e-3
parameters r_tc2=9.78e-6
parameters r_tnom=25
parameters r_l=s*(r_length-2*r_dl)
parameters r_w=r_width-2*r_dw
parameters r_n=r_l/r_w
parameters r_temp=1+r_tc1*($temp+dtemp-r_tnom)+r_tc2*($temp+dtemp-r_tnom)*($temp+dtemp-r_tnom)
//* model for terminal resistor
model nwell_t sp_resistor ( 
  rsh=250 tc1=1.72e-3 tc2=9.34e-6 tnom=25
)
//* model for substrate capacitor
model nwp sp_diode ( 
  cj=0.00014917 mj=0.33979 pb=0.5755 cjsw=5.8113e-010 mjsw=0.2257 php=0.55456
  cta=0.0023998 ctp=0.0010977 tpb=0.0027641 tphp=0.0019629 tlevc=1 tref=25
)
//*-------------------
//* terminal 1
rt1 (1 11) nwell_t  l=s*1u w=r_w dtemp=dtemp $mfactor=m
d1 (3 1) nwp  area=r_w*r_l/2 pj=r_w+2*r_l/2 dtemp=dtemp $mfactor=m
//* body
rb (11 21) (
  
  i=m*(v(11,21)/(r_temp*r_n*(r_rsh0+r_vc1*abs(v(11,21))/r_n+r_vc2*abs(v(11,21))*abs(v(11,21))/r_n/r_n)))
)
//* terminal 2
rt2 (21 2) nwell_t  l=s*1u w=r_w dtemp=dtemp $mfactor=m
d2 (3 2) nwp  area=r_w*r_l/2 pj=r_w+2*r_l/2 dtemp=dtemp $mfactor=m
//*-------------------
ends
//*******************************************************************************************************
//*******************************************************************************************************
//* model for n+ poly on field oxide resistor
subckt npolyf_u(1 2 3)
parameters m=1
parameters r_length=1u
parameters r_width=1u
parameters dtemp=0
parameters par=1
parameters s=1
parameters r_rsh0=rsh_npolyf_u*(1+mc_rsh_npolyf_u/(rsh_npolyf_u)*res_mc_skew*sw_stat_global)
parameters r_dw=0.0265e-6*(1+mc_dw_npolyf_u*res_mc_skew*sw_stat_global)
parameters r_dl=8.48e-11
parameters r_vc1=0
parameters r_vc2=0
parameters r_tc1=-1.4e-3
parameters r_tc2=2.2e-6
parameters r_tnom=25
parameters r_l=s*(r_length-2*r_dl)
parameters r_w=r_width-2*r_dw
parameters r_n=r_l/r_w
parameters r_temp=1+r_tc1*($temp+dtemp-r_tnom)+r_tc2*($temp+dtemp-r_tnom)*($temp+dtemp-r_tnom)
parameters mis_r=0

model npolyf_u_body sp_resistor ( 
  af=1.684 kf=3.6e-23 noise=1
)
//* model for terminal resistor
model npolyf_u_t sp_resistor ( 
  rsh=40+mc_rt_npolyf_u*res_mc_skew*sw_stat_global tc1=-0.735e-3 tc2=-1.7e-6
  tnom=25 af=1.684 kf=3.6e-23 noise=1
)
//* model for substrate capacitor (pF/um2)
model fox_sub sp_capacitor ( 
  cox=8.85e-05
)
//*-------------------
//* terminal 1
rt1 (1 11) npolyf_u_t  l=s*1u w=r_w dtemp=dtemp $mfactor=m
c1 (1 3) fox_sub  l=r_l/2 w=r_w dtemp=dtemp $mfactor=m
//* body
rb (11 21) (
  expr=r_temp*r_n*(r_rsh0+r_vc1*abs(v(11,21))/r_n+r_vc2*abs(v(11,21))*abs(v(11,21))/r_n/r_n)*(1+mis_r*sw_stat_mismatch)
  declarations=<<<DECL
    parameter real w=10e-6;
    parameter real l=10e-6;
    parameter real temp=27;
    parameter real dtemp=0;
    parameter real kf = 0;
    parameter real af = 1;
    parameter real ef = 1;
    parameter real short = 0;
    parameter real narrow = 0;
    parameter real lf = 1;
    parameter real wf = 1;
    parameter integer noise = 1;
    real devTemp;
    real noiseArea;
    real cpscale = $simparam("scale", 1);
    real r;
    real i;
  >>>DECL
  evaluation=<<<EVAL
    if ($param_given(temp)) devTemp = temp+`P_CELSIUS0;
    else devTemp = $temperature + dtemp;
    if ($param_given(w) || $param_given(l)) begin
      noiseArea = pow(l*cpscale-2*short, lf)*pow(w*cpscale-2*narrow, wf);
    end else begin
      noiseArea = 1;
    end
    r = #expr#;
    i = V(br)/r;

    I(br) <+ i;
    if (noise) begin
      I(br) <+ white_noise(4*`P_K*devTemp/r, "thermal");
      I(br) <+ flicker_noise(kf*pow(i, af)/noiseArea, ef, "flicker");
    end
  >>>EVAL
), (
  af=1.684 kf=3.6e-23 noise=1
)
//* terminal 2
rt2 (21 2) npolyf_u_t  l=s*1u w=r_w dtemp=dtemp $mfactor=m
c2 (2 3) fox_sub  l=r_l/2 w=r_w dtemp=dtemp $mfactor=m
//*-------------------
ends
//*******************************************************************************************************
//* model for P+ poly on field oxide resistor
subckt ppolyf_u(1 2 3)
parameters m=1
parameters r_length=1u
parameters r_width=1u
parameters dtemp=0
parameters par=1
parameters s=1
parameters r_rsh0=rsh_ppolyf_u*(1+mc_rsh_ppolyf_u/(rsh_ppolyf_u)*res_mc_skew*sw_stat_global)
parameters r_dw=2.55e-8*(1+mc_dw_ppolyf_u*res_mc_skew*sw_stat_global)
parameters r_dl=2e-11
parameters r_vc1=0
parameters r_vc2=0
parameters r_tc1=-0.9e-4
parameters r_tc2=7e-7
parameters r_tnom=25
parameters r_l=s*(r_length-2*r_dl)
parameters r_w=r_width-2*r_dw
parameters r_n=r_l/r_w
parameters r_temp=1+r_tc1*($temp+dtemp-r_tnom)+r_tc2*($temp+dtemp-r_tnom)*($temp+dtemp-r_tnom)
parameters mis_r=0

model ppolyf_u_body sp_resistor ( 
  af=1.79 kf=2.4e-23 noise=1
)
//* model for terminal resistor
model ppolyf_u_t sp_resistor ( 
  rsh=60+mc_rt_ppolyf_u*res_mc_skew*sw_stat_global tc1=-1.47e-3 tc2=0.82e-6
  tnom=25 af=1.79 kf=2.4e-23 noise=1
)
//* model for substrate capacitor (pF/um2)
model fox_sub sp_capacitor ( 
  cox=8.85e-05
)
//*-------------------
//* terminal 1
rt1 (1 11) ppolyf_u_t  l=s*1u w=r_w dtemp=dtemp $mfactor=m
c1 (1 3) fox_sub  l=r_l/2 w=r_w dtemp=dtemp $mfactor=m
//* body
rb (11 21) (
  expr=(r_temp*r_n*(r_rsh0+r_vc1*abs(v(11,21))/r_n+r_vc2*abs(v(11,21))*abs(v(11,21))/r_n/r_n))*(1+mis_r*sw_stat_mismatch)
  declarations=<<<DECL
    parameter real w=10e-6;
    parameter real l=10e-6;
    parameter real temp=27;
    parameter real dtemp=0;
    parameter real kf = 0;
    parameter real af = 1;
    parameter real ef = 1;
    parameter real short = 0;
    parameter real narrow = 0;
    parameter real lf = 1;
    parameter real wf = 1;
    parameter integer noise = 1;
    real devTemp;
    real noiseArea;
    real cpscale = $simparam("scale", 1);
    real r;
    real i;
  >>>DECL
  evaluation=<<<EVAL
    if ($param_given(temp)) devTemp = temp+`P_CELSIUS0;
    else devTemp = $temperature + dtemp;
    if ($param_given(w) || $param_given(l)) begin
      noiseArea = pow(l*cpscale-2*short, lf)*pow(w*cpscale-2*narrow, wf);
    end else begin
      noiseArea = 1;
    end
    r = #expr#;
    i = V(br)/r;

    I(br) <+ i;
    if (noise) begin
      I(br) <+ white_noise(4*`P_K*devTemp/r, "thermal");
      I(br) <+ flicker_noise(kf*pow(i, af)/noiseArea, ef, "flicker");
    end
  >>>EVAL
), (
  af=1.79 kf=2.4e-23 noise=1
)
//* terminal 2
rt2 (21 2) ppolyf_u_t  l=s*1u w=r_w dtemp=dtemp $mfactor=m
c2 (2 3) fox_sub  l=r_l/2 w=r_w dtemp=dtemp $mfactor=m
//*-------------------
ends
