//***************************************************************************************
//*
// .lib sm141064.ngspice efuse
//******************************************************************************
//*
//*  A single resistor is used to simulate the resistance.
//*
//*                                  Rfuse
//*                          in  o--/\/\/\/--o  out
//*
//*******************************************************************************
//*
//*  SYNTAX:
//*
//*    Specify fuse as intact (default, pblow=0) or programmed (pblow=1).
//*
//*    xxx  in out  efuse (pblow=0)
//*
//*  NOTES:
//*
//*  1. Model values based on PCELL layout as provided in the design kit. No
//*     other geometries or layouts are supported.
//*
//*  2. Resistance toggles between maximum spec value for intact fuse (<200 ohm)
//*     and minimum end of life value for programmed fuse (> 900 ohm).
//*
//*******************************************************************************
//*
subckt efuse(in out)
parameters m=1
parameters pblow=0
//*
rfuse (in out) gf180_default_mod_r  r=200*(1-pblow)+900*pblow $mfactor=m
//*
ends

// .lib sm141064.ngspice res_statistical_par
parameters mc_rsh_nplus_u=0 mc_rsh_pplus_u=0 mc_rsh_nplus_s=0 mc_rsh_pplus_s=0 mc_rsh_npolyf_u=0 mc_rsh_ppolyf_u=0 mc_rsh_npolyf_s=0 mc_rsh_ppolyf_s=0 mc_rsh_ppolyf_u_1k=0 mc_rsh_ppolyf_u_2k=0 mc_rsh_ppolyf_u_1k_6p0=0 mc_rsh_ppolyf_u_2k_6p0=0 mc_rsh_ppolyf_u_3k=0 mc_dw_nplus_u=0 mc_dw_pplus_u=0 mc_dw_nplus_s=0 mc_dw_pplus_s=0 mc_dw_npolyf_u=0 mc_dw_ppolyf_u=0 mc_dw_npolyf_s=0 mc_dw_ppolyf_s=0 mc_dw_ppolyf_u_1k=0 mc_dw_ppolyf_u_2k=0 mc_dw_ppolyf_u_1k_6p0=0 mc_dw_ppolyf_u_2k_6p0=0 mc_dw_ppolyf_u_3k=0 mc_rt_nplus_u=0 mc_rt_pplus_u=0 mc_rt_npolyf_u=0 mc_rt_ppolyf_u=0 mc_rt_ppolyf_u_1k=0 mc_rt_ppolyf_u_2k=0 mc_rt_ppolyf_u_1k_6p0=0 mc_rt_ppolyf_u_2k_6p0=0 mc_rt_ppolyf_u_3k=0


endsection

section ss
// Converted from GlobalFoundries gf180mcuD PDK for Ngspice

parameters rsh_nplus_u=75 rsh_pplus_u=225 rsh_nplus_s=15 rsh_pplus_s=15 rsh_nwell=1200 rsh_npolyf_u=370 rsh_ppolyf_u=420 rsh_npolyf_s=15 rsh_ppolyf_s=15 rsh_ppolyf_u_1k=1000+200 rsh_ppolyf_u_2k=2000+400 rsh_ppolyf_u_1k_6p0=1000+200 rsh_ppolyf_u_2k_6p0=2000+400 rsh_ppolyf_u_3k=3000+750 rsh_rm1=0.09+0.012 rsh_rm2=0.09+0.012 rsh_rm3=0.09+0.012 rsh_tm6k=60e-3+10e-3 rsh_tm9k=40e-3+9e-3 rsh_tm11k=40e-3+9e-3 rsh_tm30k=9.5e-3+4.5e-3
//*
// .lib sm141064.ngspice res
//* model for unsalicided n+ diffusion resistor
subckt nplus_u(1 2 3)
parameters m=1
parameters r_length=1u
parameters r_width=1u
parameters dtemp=0
parameters par=1
parameters s=1
parameters r_rsh0=rsh_nplus_u*(1+(mc_rsh_nplus_u/(rsh_nplus_u))*res_mc_skew*sw_stat_global)
parameters r_dw=-5e-8*(1+mc_dw_nplus_u*res_mc_skew*sw_stat_global)
parameters r_dl=2e-11
parameters r_vc1=0
parameters r_vc2=0
parameters r_tc1=1.36e-3
parameters r_tc2=6.5e-7
parameters r_tnom=25
parameters r_l=s*(r_length-2*r_dl)
parameters r_w=r_width-2*r_dw
parameters r_n=r_l/r_w
parameters r_temp=1+r_tc1*($temp+dtemp-r_tnom)+r_tc2*($temp+dtemp-r_tnom)*($temp+dtemp-r_tnom)
parameters mis_r=0

//* model for terminal resistor
model nplus_u_t sp_resistor ( 
  rsh=18.5+mc_rt_nplus_u*res_mc_skew*sw_stat_global tc1=8.5e-4 tc2=1.75e-6
  tnom=25
)
//* model for substrate capacitor
model np_3p3 sp_diode ( 
  cj=0.00096797 mj=0.32071 pb=0.70172 cjsw=1.5663e-010 mjsw=0.1 php=0.8062
  cta=0.0009438 ctp=0.00060474 tpb=0.0018129 tphp=5e-005 tlevc=1 tref=25
)
//*-------------------
//* terminal 1
rt1 (1 11) nplus_u_t  l=s*1u w=r_w dtemp=dtemp $mfactor=m
d1 (3 1) np_3p3  area=r_w*r_l/2 pj=r_w+2*r_l/2 dtemp=dtemp $mfactor=m
//* body
rb (11 21) (
  
  i=m*(v(11,21)/(r_temp*r_n*(r_rsh0+r_vc1*abs(v(11,21))/r_n+r_vc2*abs(v(11,21))*abs(v(11,21))/r_n/r_n)*(1+mis_r*sw_stat_mismatch)))
)
//* terminal 2
rt2 (21 2) nplus_u_t  l=s*1u w=r_w dtemp=dtemp $mfactor=m
d2 (3 2) np_3p3  area=r_w*r_l/2 pj=r_w+2*r_l/2 dtemp=dtemp $mfactor=m
//*-------------------
ends
//*******************************************************************************************************
//* model for unsalicided p+ diffusion resistor
