//* model for metal 1 resistor
subckt rm1(1 2)
parameters m=1
parameters r_length=1u
parameters r_width=1u
parameters dtemp=0
parameters par=1
parameters s=1
parameters r_rsh0=rsh_rm1
parameters r_dw=0
parameters r_dl=0
parameters r_vc1=0
parameters r_vc2=0
parameters r_tc1=3.33e-3
parameters r_tc2=0
parameters r_tnom=25
parameters r_l=s*(r_length-2*r_dl)
parameters r_w=r_width-2*r_dw
parameters r_n=r_l/r_w
parameters r_temp=1+r_tc1*($temp+dtemp-r_tnom)+r_tc2*($temp+dtemp-r_tnom)*($temp+dtemp-r_tnom)
