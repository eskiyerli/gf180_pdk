parameters r_dl=5.0e-11
parameters r_vc1=0
parameters r_vc2=0
parameters r_tc1=1.375e-3
parameters r_tc2=1e-6
parameters r_tnom=25
parameters r_l=s*(r_length-2*r_dl)
parameters r_w=r_width-2*r_dw
parameters r_n=r_l/r_w
