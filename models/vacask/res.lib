  cj=0.00096797 mj=0.32071 pb=0.70172 cjsw=1.5663e-010 mjsw=0.1 php=0.8062
  cta=0.0009438 ctp=0.00060474 tpb=0.0018129 tphp=5e-005 tlevc=1 tref=25
)
//*-------------------
//* terminal 1
rt1 (1 11) nplus_s_t  l=s*1u w=r_w dtemp=dtemp $mfactor=m
d1 (3 1) np_3p3  area=r_w*r_l/2 pj=r_w+2*r_l/2 dtemp=dtemp $mfactor=m
//* body
rb (11 21) (
  
  i=m*(v(11,21)/(r_temp*r_n*(r_rsh0+r_vc1*abs(v(11,21))/r_n+r_vc2*abs(v(11,21))*abs(v(11,21))/r_n/r_n)))
)
//* terminal 2
rt2 (21 2) nplus_s_t  l=s*1u w=r_w dtemp=dtemp $mfactor=m
d2 (3 2) np_3p3  area=r_w*r_l/2 pj=r_w+2*r_l/2 dtemp=dtemp $mfactor=m
//*-------------------
ends
