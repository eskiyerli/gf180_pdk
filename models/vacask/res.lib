)
//* terminal 2
rt2 (21 2) pplus_s_t  l=s*1u w=r_w dtemp=dtemp $mfactor=m
d2 (2 3) pn_3p3  area=r_w*r_l/2 pj=r_w+2*r_l/2 dtemp=dtemp $mfactor=m
//*-------------------
