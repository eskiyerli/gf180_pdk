      I(br) <+ flicker_noise(kf*pow(i, af)/noiseArea, ef, "flicker");
    end
  >>>EVAL
), (
  af=1 kf=2.62e-26 noise=1
)
//* terminal 2
rt2 (21 2) ppolyf_u_2k_t  l=s*1u w=r_w dtemp=dtemp $mfactor=m
c2 (2 3) fox_sub  l=r_l/2 w=r_w dtemp=dtemp $mfactor=m
//*-------------------
ends
//*******************************************************************************************************
//*** model for 3k high-rs P+ poly on field oxide resistor (LV & MVarea)
//*******************************************************************************************************
//* model for 3k high-Rs P+ poly on field oxide resistor
subckt ppolyf_u_3k(1 2 3)
parameters m=1
parameters r_length=1u
parameters r_width=1u
parameters dtemp=0
parameters par=1
parameters s=1
//*-------------------
//* model for body resistor
parameters r_rsh0=rsh_ppolyf_u_3k*(1+mc_rsh_ppolyf_u_3k/(rsh_ppolyf_u_3k)*res_mc_skew*sw_stat_global) r_dw=0.02256e-6*(1+mc_dw_ppolyf_u_3k*res_mc_skew*sw_stat_global) r_dl=-0.0932e-6 r_vc1=0 r_vc2=0 r_tc1=-0.001669823 r_tc2=3.74326e-06 r_tnom=25 r_l=s*(r_length-2*r_dl) r_w=r_width-2*r_dw r_n=r_l/r_w r_temp=1+r_tc1*($temp+dtemp-r_tnom)+r_tc2*($temp+dtemp-r_tnom)*($temp+dtemp-r_tnom)
model ppolyf_u_3k_body sp_resistor ( 
  af=1 kf=2.62e-26 noise=1
)
//* model for terminal resistor
model ppolyf_u_3k_t sp_resistor ( 
  rsh=33.16+mc_rt_ppolyf_u_3k*res_mc_skew*sw_stat_global tc1=-0.003763316
  tc2=9.81166e-06 tnom=25 af=1 kf=2.62e-26
)
//* model for substrate capacitor (pF/um2)
model fox_sub sp_capacitor ( 
  cox=8.85e-05
)
//*-------------------
//* terminal 1
rt1 (1 11) ppolyf_u_3k_t  l=s*1u w=r_w dtemp=dtemp $mfactor=m
c1 (1 3) fox_sub  l=r_l/2 w=r_w dtemp=dtemp $mfactor=m
//* body
rb (11 21) (
  expr=r_temp*r_n*(r_rsh0+r_vc1*abs(v(11,21))/r_n+r_vc2*abs(v(11,21))*abs(v(11,21))/r_n/r_n)
  declarations=<<<DECL
    parameter real w=10e-6;
    parameter real l=10e-6;
    parameter real temp=27;
    parameter real dtemp=0;
    parameter real kf = 0;
    parameter real af = 1;
    parameter real ef = 1;
    parameter real short = 0;
    parameter real narrow = 0;
    parameter real lf = 1;
    parameter real wf = 1;
    parameter integer noise = 1;
    real devTemp;
    real noiseArea;
    real cpscale = $simparam("scale", 1);
    real r;
    real i;
  >>>DECL
  evaluation=<<<EVAL
    if ($param_given(temp)) devTemp = temp+`P_CELSIUS0;
    else devTemp = $temperature + dtemp;
    if ($param_given(w) || $param_given(l)) begin
      noiseArea = pow(l*cpscale-2*short, lf)*pow(w*cpscale-2*narrow, wf);
    end else begin
      noiseArea = 1;
    end
    r = #expr#;
    i = V(br)/r;

    I(br) <+ i;
    if (noise) begin
      I(br) <+ white_noise(4*`P_K*devTemp/r, "thermal");
      I(br) <+ flicker_noise(kf*pow(i, af)/noiseArea, ef, "flicker");
    end
  >>>EVAL
), (
  af=1 kf=2.62e-26 noise=1
)
//* terminal 2
rt2 (21 2) ppolyf_u_3k_t  l=s*1u w=r_w dtemp=dtemp $mfactor=m
c2 (2 3) fox_sub  l=r_l/2 w=r_w dtemp=dtemp $mfactor=m
//*-------------------
ends
//*******************************************************************************************************
//* model for metal 1 resistor
subckt rm1(1 2)
parameters m=1
parameters r_length=1u
parameters r_width=1u
parameters dtemp=0
parameters par=1
parameters s=1
parameters r_rsh0=rsh_rm1
parameters r_dw=0
parameters r_dl=0
parameters r_vc1=0
parameters r_vc2=0
parameters r_tc1=3.33e-3
parameters r_tc2=0
parameters r_tnom=25
parameters r_l=s*(r_length-2*r_dl)
parameters r_w=r_width-2*r_dw
parameters r_n=r_l/r_w
parameters r_temp=1+r_tc1*($temp+dtemp-r_tnom)+r_tc2*($temp+dtemp-r_tnom)*($temp+dtemp-r_tnom)
//*-------------------
//* body
rb (1 2) (
  
  i=m*(v(1,2)/(r_temp*r_n*(r_rsh0+r_vc1*abs(v(1,2))/r_n+r_vc2*abs(v(1,2))*abs(v(1,2))/r_n/r_n)))
)
//*-------------------
ends
