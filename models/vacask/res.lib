  cj=0.00094344 mj=0.32084 pb=0.69939 cjsw=1.5078e-010 mjsw=0.05 php=0.8022
  cta=0.00099187 ctp=0.00063483 tpb=0.0016906 tphp=0.0058423 tlevc=1 tref=25
)
//*-------------------
//* terminal 1
rt1 (1 11) pplus_s_t  l=s*1u w=r_w dtemp=dtemp $mfactor=m
